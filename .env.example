# ==========================================
# तपाईंको TV — Production Environment Variables
# ==========================================

# Port the Express server listens on (defaults to 3000)
PORT=3000

# Administrator Email(s) for Control Room Google Authentication
# (Comma-separated for multiple administrators)
ADMIN_EMAIL="ceoofcrypto@gmail.com"

# App public URL
APP_URL="http://localhost:3000"

# Optional Gemini AI API Key (for smart IPTV channel curation & metadata)
GEMINI_API_KEY=""

# ------------------------------------------
# Firebase Authentication & Firestore Config
# ------------------------------------------
# To enable production Google Sign-In:
# 1. Create a project at https://console.firebase.google.com/
# 2. Go to Authentication > Sign-in method > Enable Google
# 3. Under Authentication > Settings > Authorized domains, add your domains:
#    - localhost
#    - yourdomain.com
# 4. Copy your Web App config keys below:

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
FIREBASE_PROJECT_ID=""
