rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'ceoofcrypto@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUrl(url) {
      return url is string && url.size() <= 1000 && (
        url.matches("^https://.*") ||
        url.matches("^http://.*") ||
        url.matches("^/.*") ||
        url == ""
      );
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidChannel(data) {
      return data.keys().hasAll(['id', 'name', 'streamUrl', 'categoryId', 'isActive', 'isPublished']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             isValidUrl(data.streamUrl) &&
             data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 100 &&
             data.isActive is bool &&
             data.isPublished is bool;
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['id', 'title', 'channelId', 'status', 'priority', 'isActive', 'isPublished']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.channelId is string && data.channelId.size() > 0 && data.channelId.size() <= 100 &&
             data.status in ['UPCOMING', 'LIVE', 'ENDED', 'CANCELLED'] &&
             data.priority is number &&
             data.isActive is bool &&
             data.isPublished is bool;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'isActive', 'displayOrder']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.slug is string && data.slug.size() > 0 && data.slug.size() <= 100 &&
             data.isActive is bool &&
             data.displayOrder is number;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['id', 'title', 'message', 'isActive', 'isPublished']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 1000 &&
             data.isActive is bool &&
             data.isPublished is bool;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /channels/{channelId} {
      allow get: if isValidId(channelId) && (resource == null || resource.data.isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create, update: if isAdmin() && isValidId(channelId) && isValidChannel(incoming());
      allow delete: if isAdmin() && isValidId(channelId);
    }

    match /events/{eventId} {
      allow get: if isValidId(eventId) && (resource == null || resource.data.isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create, update: if isAdmin() && isValidId(eventId) && isValidEvent(incoming());
      allow delete: if isAdmin() && isValidId(eventId);
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId) && (resource == null || resource.data.isActive == true || isAdmin());
      allow list: if resource.data.isActive == true || isAdmin();
      allow create, update: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && (resource == null || resource.data.isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create, update: if isAdmin() && isValidId(announcementId) && isValidAnnouncement(incoming());
      allow delete: if isAdmin() && isValidId(announcementId);
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if isAdmin();
      allow write: if isAdmin() && isValidId(settingId);
    }

    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isAdmin() || (isSignedIn() && request.auth.uid == adminUid));
      allow list: if isAdmin();
      allow write: if isAdmin() && isValidId(adminUid);
    }
  }
}
